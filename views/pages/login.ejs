<main class="auth-page">

    <section class="auth-card">

        <div class="auth-heading">
            <h1>Log into Nosta</h1>
        </div>

        <form class="auth-form" action="/login" method="post"> //# ADD THIS TO src/app.controller.ts as a post method

            <div class="form-group">
                <label for="username">Username</label>
                <input id="username"
                type="text"
                name="username"
                placeholder="Enter your username"
                maxlength="30"
                required>
            </div>

            <div class="form-group">
                <lable>Password</lable>
                <input id="password"
                type="password"
                name="password"
                placeholder="Enter your password"
                required>
            </div>

            <button class="button button-primary button-full"
            type="submit">
            Log in
            </button>
        </form>
    </section>











</main>